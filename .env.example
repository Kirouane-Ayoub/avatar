# ─────────────────────────────────────────────────────────────
# LiveKit
# ─────────────────────────────────────────────────────────────
# LIVEKIT_URL is what the agent uses from inside Docker (container name).
# LIVEKIT_EXTERNAL_URL is what the browser uses (reachable from the host).
LIVEKIT_URL=ws://livekit-server:7880
LIVEKIT_EXTERNAL_URL=ws://localhost:7880

# Dev-mode default creds from `livekit-server --dev`.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ─────────────────────────────────────────────────────────────
# LLM (OpenAI-compatible endpoint)
# ─────────────────────────────────────────────────────────────
# Pick ONE of the examples below, or provide your own.

# A) Local MLX on macOS (start with ./start-llm.sh or ./run.sh start)
LLM_BASE_URL=http://host.docker.internal:8090/v1
LLM_API_KEY=none
LLM_MODEL=mlx-community/Qwen3.5-2B-MLX-4bit
# TurboQuant KV-cache quantization: 3.5 = 3-bit keys + 4-bit values.
# Cuts KV memory ~50% with negligible quality loss; helps the 27B VL
# model with vision turns. Set to "off" for an uncompressed cache.
LLM_KV_BITS=3.5
LLM_KV_QUANT_SCHEME=turboquant

# B) OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# C) vLLM / self-hosted
# LLM_BASE_URL=http://your-vllm-host:8000/v1
# LLM_API_KEY=none
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ─────────────────────────────────────────────────────────────
# TTS (Kokoro FastAPI — runs in Docker as `kokoro-tts`)
# ─────────────────────────────────────────────────────────────
TTS_BASE_URL=http://kokoro-tts:8880
TTS_MODEL=kokoro

# Default voices by (language, body). Agent picks one per session from the
# wizard's avatar body + language. Override any of these to change the voice.
TTS_VOICE_FEMALE_EN=af_heart
TTS_VOICE_MALE_EN=am_michael
TTS_VOICE_FEMALE_JA=jf_alpha
TTS_VOICE_MALE_JA=jm_kumo

# ─────────────────────────────────────────────────────────────
# STT (Speaches / Faster-Whisper — runs in Docker as `speaches`)
# ─────────────────────────────────────────────────────────────
# Keep this in sync with the model docker-compose.yml pre-downloads.
STT_BASE_URL=http://speaches:8000/v1
STT_MODEL=Systran/faster-whisper-tiny

# ─────────────────────────────────────────────────────────────
# Ambient affect VLM (optional — Blaizzy/mlx-vlm)
# ─────────────────────────────────────────────────────────────
# When set, the agent runs a background watcher that samples camera frames
# between turns and emits subtle mood cues from a small VLM. Without these
# vars, the avatar's mood only changes at LLM reply time.
# Bring up the host-side server with: VLM=1 ./run.sh start
VLM_BASE_URL=http://host.docker.internal:5006
VLM_MODEL=mlx-community/Qwen3-VL-2B-Instruct-4bit
# Watcher KV cache: leave empty (uncompressed). The 2B model with single-frame
# prompts has negligible KV pressure; quantization adds overhead with no
# meaningful benefit at this size. Set VLM_KV_BITS=3.5 to opt in anyway.
VLM_KV_BITS=
VLM_KV_QUANT_SCHEME=turboquant

# ─────────────────────────────────────────────────────────────
# UI
# ─────────────────────────────────────────────────────────────
UI_PORT=3000
