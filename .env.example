# ─────────────────────────────────────────────────────────────
# LiveKit
# ─────────────────────────────────────────────────────────────
# LIVEKIT_URL is what the agent uses from inside Docker (container name).
# LIVEKIT_EXTERNAL_URL is what the browser uses (reachable from the host).
LIVEKIT_URL=ws://livekit-server:7880
LIVEKIT_EXTERNAL_URL=ws://localhost:7880

# Dev-mode default creds from `livekit-server --dev`.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ─────────────────────────────────────────────────────────────
# LLM (OpenAI-compatible endpoint)
# ─────────────────────────────────────────────────────────────
# Pick ONE of the examples below, or provide your own.

# A) Local MLX on macOS (start with ./start-llm.sh or ./run.sh start)
LLM_BASE_URL=http://host.docker.internal:8090/v1
LLM_API_KEY=none
LLM_MODEL=mlx-community/Qwen3.5-2B-MLX-4bit
# TurboQuant KV-cache quantization: 3.5 = 3-bit keys + 4-bit values.
# Cuts KV memory ~50% with negligible quality loss; helps the 27B VL
# model with vision turns. Set to "off" for an uncompressed cache.
LLM_KV_BITS=3.5
LLM_KV_QUANT_SCHEME=turboquant

# B) OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# C) vLLM / self-hosted
# LLM_BASE_URL=http://your-vllm-host:8000/v1
# LLM_API_KEY=none
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ─────────────────────────────────────────────────────────────
# TTS (Kokoro FastAPI — runs in Docker as `kokoro-tts`)
# ─────────────────────────────────────────────────────────────
TTS_BASE_URL=http://kokoro-tts:8880
TTS_MODEL=kokoro

# Default voices by (language, body). Agent picks one per session from the
# wizard's avatar body + language. Override any of these to change the voice.
TTS_VOICE_FEMALE_EN=af_heart
TTS_VOICE_MALE_EN=am_michael
TTS_VOICE_FEMALE_JA=jf_alpha
TTS_VOICE_MALE_JA=jm_kumo

# ─────────────────────────────────────────────────────────────
# STT (Speaches / Faster-Whisper — runs in Docker as `speaches`)
# ─────────────────────────────────────────────────────────────
# Keep this in sync with the model docker-compose.yml pre-downloads.
STT_BASE_URL=http://speaches:8000/v1
STT_MODEL=Systran/faster-whisper-tiny

# ─────────────────────────────────────────────────────────────
# Ambient affect VLM (optional — Blaizzy/mlx-vlm)
# ─────────────────────────────────────────────────────────────
# When set, the agent runs a background watcher that samples camera frames
# between turns and emits subtle mood cues from a small VLM. Without these
# vars, the avatar's mood only changes at LLM reply time.
# Bring up the host-side server with: VLM=1 ./run.sh start
VLM_BASE_URL=http://host.docker.internal:5006
VLM_MODEL=mlx-community/Qwen3-VL-2B-Instruct-4bit
# Watcher KV cache: leave empty (uncompressed). The 2B model with single-frame
# prompts has negligible KV pressure; quantization adds overhead with no
# meaningful benefit at this size. Set VLM_KV_BITS=3.5 to opt in anyway.
VLM_KV_BITS=
VLM_KV_QUANT_SCHEME=turboquant

# ─────────────────────────────────────────────────────────────
# Persistent memory (Mem0, embedded SDK; Postgres+pgvector container)
# ─────────────────────────────────────────────────────────────
# When MEM0_PG_HOST is set, the agent records every turn to per-user
# memory and recalls relevant context at session start. Leaving it unset
# disables memory cleanly (NullProvider — no errors, no calls).
# Postgres is brought up by docker-compose (service: postgres-memory).
MEM0_PG_HOST=postgres-memory
MEM0_PG_PORT=5432
MEM0_PG_USER=mem0
MEM0_PG_PASSWORD=mem0
MEM0_PG_DBNAME=mem0
# Fact-extraction LLM. Defaults to LLM_BASE_URL/MODEL above if unset;
# point at the small VLM (port 5006) to keep the chat 27B free of
# extraction load.
# MEM0_LLM_BASE_URL=http://host.docker.internal:5006/v1
# MEM0_LLM_MODEL=mlx-community/Qwen3-VL-2B-Instruct-4bit
# MEM0_LLM_API_KEY=none
# Embedder. Default = Ollama on the host (free, ships an OpenAI-
# compatible /v1/embeddings endpoint out of the box, no shim needed).
# Three modes documented below.
#
# A) RECOMMENDED: Ollama (~46 MB all-minilm, 384 dims). Install Ollama
#    once (see CLAUDE.md), then `ollama pull all-minilm`. Ollama runs
#    as a host service; agent reaches it via host.docker.internal:11434.
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER=all-minilm
MEM0_EMBEDDER_BASE_URL=http://host.docker.internal:11434/v1
MEM0_EMBEDDER_API_KEY=ollama
MEM0_EMBEDDER_DIMS=384
#
# B) Local sentence-transformers in the agent container (CPU only, no
#    Metal because Docker on macOS can't reach GPU). Slower per encode
#    but zero new infra — useful if you don't want to install Ollama.
# MEM0_EMBEDDER_PROVIDER=huggingface
# MEM0_EMBEDDER=BAAI/bge-small-en-v1.5
#
# C) Hosted OpenAI (paid). For when you want maximum recall quality
#    and don't mind the API bill.
# MEM0_EMBEDDER_PROVIDER=openai
# MEM0_EMBEDDER=text-embedding-3-small
# MEM0_EMBEDDER_BASE_URL=https://api.openai.com/v1
# MEM0_EMBEDDER_API_KEY=sk-...
# MEM0_EMBEDDER_DIMS=1536
#
# IMPORTANT — pgvector stores fixed-dim vectors. If you switch embedders
# to one with different dims (e.g. all-minilm=384 → text-embedding-3-small
# =1536), drop the existing collection first or use a fresh DB:
#   docker exec postgres-memory psql -U mem0 -d mem0 -c \
#     "DROP TABLE IF EXISTS lisa_memories;"

# ─────────────────────────────────────────────────────────────
# Auth (sign-in / sign-out, per-user profiles, multi-user memory)
# ─────────────────────────────────────────────────────────────
# Secret used to sign session JWTs at /api/login. MUST be set; the
# token server refuses to start without one. Generate yourself with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Same secret is read by the token server (issuer) and the agent
# (verifier) — both run in the same container so a single .env covers
# both. Rotate to invalidate all existing sessions.
JWT_SECRET=replace-me-with-output-of-secrets.token_urlsafe-64
# Session JWT lifetime in days. Returning users skip re-auth within
# this window. 7 is a sensible default for a voice-friend app.
SESSION_TOKEN_TTL_DAYS=7

# Users + profile DB. Defaults reuse the existing postgres-memory
# container — the `users` table sits alongside Mem0's `lisa_memories`
# in the same Postgres database. Override these to split if needed.
# APP_PG_HOST=postgres-memory
# APP_PG_PORT=5432
# APP_PG_USER=mem0
# APP_PG_PASSWORD=mem0
# APP_PG_DBNAME=mem0

# ─────────────────────────────────────────────────────────────
# UI
# ─────────────────────────────────────────────────────────────
UI_PORT=3000
